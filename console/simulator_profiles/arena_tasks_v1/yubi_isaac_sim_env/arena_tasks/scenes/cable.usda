    over "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        bool physxScene:enableCCD = 1
    }

    def "ArenaObjects"
    {
        def Xform "yubi_fixture" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.00041981574, -0.00027549724, 0.006849963)
            float3 physics:diagonalInertia = (0.000009601861, 0.00010614194, 0.00010956236)
            bool physics:kinematicEnabled = 1
            float physics:mass = 0.2
            quatf physics:principalAxes = (0.9847529, -0.000003619654, -6.588444e-7, 0.17395891)
            bool physxRigidBody:enableCCD = 1
            float physxRigidBody:sleepThreshold = 0.0001
            int physxRigidBody:solverPositionIterationCount = 64
            int physxRigidBody:solverVelocityIterationCount = 8
            float physxRigidBody:stabilizationThreshold = 0.00001
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.03, 0.09, 0.752)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

