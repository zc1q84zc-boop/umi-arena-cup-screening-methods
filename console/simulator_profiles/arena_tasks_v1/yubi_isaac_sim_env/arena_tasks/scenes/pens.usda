    def "ArenaObjects"
    {
        def Xform "holder" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.05)
            float3 physics:diagonalInertia = (0.000071125, 0.000071125, 0.00004225)
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.06
            quatf physics:principalAxes = (1, 0, 0, 0)
            bool physxRigidBody:enableCCD = 1
