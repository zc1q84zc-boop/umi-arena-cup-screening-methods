#usda 1.0
(
    customLayerData = {
        string geometry_status = "CAD where identified; other dimensions/layout are demo-based estimates, not measured calibration"
        string physics_status = "mass/friction and contact tolerances are provisional"
        string task_id = "sps"
    }
    subLayers = [
        @../../scenes/dual_franka_yubi_cup40k_cupfriction_trial.usda@
    ]
)

over "World"
{
    over "Objects"
    {
        over "Cup" (
            active = false
        )
        {
        }

        over "Tray" (
            active = false
        )
        {
        }
    }

    def "ArenaLooks"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "sorter"
        {
            token outputs:surface.connect = </World/ArenaLooks/sorter/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.32, 0.62)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "CellLabels"
        {
            token outputs:surface.connect = </World/ArenaLooks/CellLabels/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.94, 0.9)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

