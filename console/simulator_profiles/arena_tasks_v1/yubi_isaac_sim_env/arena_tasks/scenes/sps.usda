    over "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        bool physxScene:enableCCD = 1
    }

    def "ArenaObjects"
    {
        def Xform "sorter" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.0325)
            float3 physics:diagonalInertia = (0.0013167916, 0.0024534583, 0.0036153332)
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.22
            quatf physics:principalAxes = (1, 0, 0, 0)
            bool physxRigidBody:enableCCD = 1
            float physxRigidBody:sleepThreshold = 0.0001
            int physxRigidBody:solverPositionIterationCount = 64
            int physxRigidBody:solverVelocityIterationCount = 8
            float physxRigidBody:stabilizationThreshold = 0.00001
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0.23, 0.752)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cube "Base" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                rel material:binding = </World/ArenaLooks/sorter>
                rel material:binding:physics = </World/ArenaLooks/Contact> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                float physxCollision:contactOffset = 0.00025
                float physxCollision:restOffset = 0
                double size = 1
                float3 xformOp:scale = (0.36, 0.26, 0.003)
                double3 xformOp:translate = (0, 0, 0.0015)
