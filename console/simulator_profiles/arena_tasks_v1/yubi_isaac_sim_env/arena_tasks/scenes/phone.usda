#usda 1.0
(
    customLayerData = {
        string geometry_status = "CAD where identified; other dimensions/layout are demo-based estimates, not measured calibration"
        string physics_status = "mass/friction and contact tolerances are provisional"
        string task_id = "phone"
    }
    subLayers = [
        @../../scenes/dual_franka_yubi_cup40k_cupfriction_trial.usda@
    ]
)

over "World"
{
    over "Objects"
    {
        over "Cup" (
            active = false
        )
        {
        }

        over "Tray" (
            active = false
        )
        {
        }
    }

    def "ArenaLooks"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "box"
        {
            token outputs:surface.connect = </World/ArenaLooks/box/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.86, 0.83)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "lid"
        {
            token outputs:surface.connect = </World/ArenaLooks/lid/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.035, 0.045)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "LidPrint"
        {
            token outputs:surface.connect = </World/ArenaLooks/LidPrint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.92, 0.88)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "divider"
        {
            token outputs:surface.connect = </World/ArenaLooks/divider/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.91, 0.91, 0.88)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "phone"
        {
            token outputs:surface.connect = </World/ArenaLooks/phone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.016, 0.02)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "PhoneGlass"
        {
            token outputs:surface.connect = </World/ArenaLooks/PhoneGlass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.014, 0.02)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "PhoneLens"
        {
            token outputs:surface.connect = </World/ArenaLooks/PhoneLens/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.13, 0.15)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }

    over "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        bool physxScene:enableCCD = 1
    }

    def "ArenaObjects"
