#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @/home/lrl/dual-franka-yubi-isaac-sim-deploy/repo/yubi_isaac_sim_env/scenes/dual_franka_yubi_random_000_seed_20260924.usda@
    ]
)

# Diagnostic only: stronger jaw drive, original cup/pad friction and original
# Panda drives. This is not a measured hardware motor limit or default scene.
over "World"
{
    over "Robots"
    {
        over "LeftMount"
        {
            over "Panda"
            {
                over "joints"
                {
                    over "yubi_finger_joint"
                    {
                        float drive:angular:physics:maxForce = 2
                        float drive:angular:physics:stiffness = 0.05
                        float drive:angular:physics:damping = 0.003
                    }
                }
            }
        }
        over "RightMount"
        {
            over "Panda"
            {
                over "joints"
                {
                    over "yubi_finger_joint"
                    {
                        float drive:angular:physics:maxForce = 2
                        float drive:angular:physics:stiffness = 0.05
                        float drive:angular:physics:damping = 0.003
                    }
                }
            }
        }
    }
}
