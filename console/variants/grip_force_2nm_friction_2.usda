#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @/home/liudiwen/dual-franka-yubi-isaac-sim-deploy/repo/yubi_isaac_sim_env/scenes/dual_franka_yubi_random_000_seed_20260924.usda@
    ]
)

over "World"
{
    over "Robots"
    {
        over "LeftMount"
        {
            over "Panda"
            {
                over "joints"
                {
                    over "yubi_finger_joint"
                    {
                        float drive:angular:physics:maxForce = 2
                        float drive:angular:physics:stiffness = 0.05
                    }
                }

                over "YubiLooks"
                {
                    over "GripPhysics"
                    {
                        float physics:dynamicFriction = 1.5
                        float physics:staticFriction = 2
                    }
                }
            }
        }

        over "RightMount"
        {
            over "Panda"
            {
                over "joints"
                {
                    over "yubi_finger_joint"
                    {
                        float drive:angular:physics:maxForce = 2
                        float drive:angular:physics:stiffness = 0.05
                    }
                }

                over "YubiLooks"
                {
                    over "GripPhysics"
                    {
                        float physics:dynamicFriction = 1.5
                        float physics:staticFriction = 2
                    }
                }
            }
        }
    }
}
