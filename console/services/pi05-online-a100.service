Environment=XLA_PYTHON_CLIENT_PREALLOCATE=false
Environment=PYTHONPATH=/mnt/data/benyun/workspace/pi05_cup_clean_20260923/scripts:/mnt/data/benyun/workspace/Corl_Umi/umi_arena_pi05_20260922/openpi/src:/mnt/data/benyun/workspace/umi-arena-evaluation
