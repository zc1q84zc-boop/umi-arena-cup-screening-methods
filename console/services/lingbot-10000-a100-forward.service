[Unit]
Description=Loopback SSH forward to clean-cup LingBot 10k simulator inference on A100

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -L 127.0.0.1:18803:127.0.0.1:18802 openwam-a100
Restart=on-failure
RestartSec=10
