[Unit]
Description=Loopback SSH reverse forward from 5090 simulator to OpenWAM 5k
After=openwam-5000-a100-forward.service
Requires=openwam-5000-a100-forward.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -R 127.0.0.1:18798:127.0.0.1:18797 lightyear-cuda
Restart=on-failure
RestartSec=10
