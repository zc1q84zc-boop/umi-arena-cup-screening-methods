[Unit]
Description=Loopback SSH forward to pi0.5 10k A100 simulator inference

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -L 127.0.0.1:18792:127.0.0.1:18790 openwam-a100
Restart=on-failure
RestartSec=10
