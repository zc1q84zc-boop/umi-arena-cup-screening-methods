WorkingDirectory=/mnt/data/benyun/workspace/umi_cup_multimodel_20260925
Environment=CUDA_VISIBLE_DEVICES=5
Environment=CUDA_HOME=/usr/local/cuda-12.8
Environment=TORCH_EXTENSIONS_DIR=/mnt/data/benyun/workspace/umi_cup_multimodel_20260925/openwam/torch_extensions_cu128
