[Unit]
Description=Loopback SSH forward to clean-cup OpenWAM simulator inference on A100

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -L 127.0.0.1:18788:127.0.0.1:18787 openwam-a100
Restart=on-failure
RestartSec=10
