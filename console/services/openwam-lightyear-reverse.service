[Unit]
Description=Loopback SSH reverse forward from 5090 simulator to OpenWAM inference
After=openwam-a100-forward.service
Requires=openwam-a100-forward.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -R 127.0.0.1:18789:127.0.0.1:18788 lightyear-cuda
Restart=on-failure
RestartSec=10
