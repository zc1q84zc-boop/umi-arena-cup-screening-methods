[Unit]
Description=Loopback SSH reverse forward from 5090 simulator to local pi0.5 bridge
After=pi05-a100-forward.service
Requires=pi05-a100-forward.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -R 127.0.0.1:18782:127.0.0.1:18780 lightyear-cuda
Restart=on-failure
RestartSec=10
