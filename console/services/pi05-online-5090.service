[Unit]
Description=UMI cup clean pi0.5 online inference on RTX 5090 GPU3
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/liudiwen/workspace/umi_cup_pi05_online_20260928
Environment=CUDA_VISIBLE_DEVICES=3
Environment=XLA_PYTHON_CLIENT_PREALLOCATE=false
Environment=PYTHONPATH=/home/liudiwen/workspace/umi_cup_pi05_online_20260928/source/umi-arena-evaluation:/home/liudiwen/workspace/umi_cup_pi05_online_20260928/source/umi-arena-evaluation/adapters/openpi_pi05:/home/liudiwen/workspace/umi_cup_pi05_online_20260928/source/openpi/src
Environment=HF_HOME=/home/liudiwen/.cache/huggingface
ExecStart=/home/liudiwen/.conda/envs/openpi311/bin/python /home/liudiwen/workspace/umi_cup_pi05_online_20260928/pi05_online_server.py --evaluation-root /home/liudiwen/workspace/umi_cup_pi05_online_20260928/source/umi-arena-evaluation --openpi-root /home/liudiwen/workspace/umi_cup_pi05_online_20260928/source/openpi --checkpoint /home/liudiwen/workspace/umi_cup_pi05_online_20260928/checkpoint/inference_export --port 18783
Restart=no
StandardOutput=append:/home/liudiwen/workspace/umi_cup_pi05_online_20260928/pi05_online_server.log
StandardError=append:/home/liudiwen/workspace/umi_cup_pi05_online_20260928/pi05_online_server.log

[Install]
WantedBy=default.target
