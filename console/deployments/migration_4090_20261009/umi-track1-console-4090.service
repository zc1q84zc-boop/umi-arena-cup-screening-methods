[Unit]
Description=Private native UMI Track1 console on dual RTX 4090

[Service]
Type=simple
WorkingDirectory=/home/claude/Corl_Track_1/umi_workspace_zhangchi/umi-track1-console-4090-20261009
ExecStart=/home/claude/Corl_Track_1/umi_workspace_zhangchi/dual-franka-yubi-isaac-sim-deploy/.venv/bin/python -u /home/claude/Corl_Track_1/umi_workspace_zhangchi/umi-track1-console-4090-20261009/native_4090_console.py
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/claude/Corl_Track_1/umi_workspace_zhangchi/umi-track1-console-4090-20261009/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
