#usda 1.0
(
    subLayers = [@dual_franka_yubi_random_000_seed_20260924.usda@]
)

# Simulator-only Panda drive tuning from SMOOTHING_REPORT.md.  Keep the
# original scene and NVIDIA source USD untouched for matched comparisons.
over "World" {
    over "Robots" {
        over "LeftMount" {
            over "Panda" {
                over "joints" {
                    over "panda_joint1" {
                        float drive:angular:physics:stiffness = 2500
                        float drive:angular:physics:damping = 70.710678
